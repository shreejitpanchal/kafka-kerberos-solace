# ------------------------------------------------------------------
# kafka-kerberos-solace : environment
# Edit and re-run `scripts/up.sh`  (or `docker compose up -d --build`)
# NOTE: keep comments on their own lines (no trailing "# ..." after values)
# ------------------------------------------------------------------

# ---- Kerberos realm served by the KDC container ----
REALM=SOLACE.LOCAL
KDC_MASTER_PASSWORD=MasterKey-ChangeMe
KADMIN_PASSWORD=admin

# Kerberos service name used by the Kafka broker (SPN = <service>/<host>@REALM)
KAFKA_SERVICE_NAME=kafka
# User principals (UPN = <name>@REALM)
SOLACE_PRINCIPAL=solace
CLIENT_PRINCIPAL=client

# ---- Images ----
KAFKA_IMAGE=apache/kafka:4.3.1

# ---- How the containers reach "localhost" of your PC ----
# Everything talks to your EXISTING Solace broker through the ports it publishes on your
# machine (PubSub+ Manager = https://localhost:1943). Inside a container "localhost" is the
# container itself, so Docker Desktop's name for your PC is used instead:
#   host.docker.internal  ==  localhost on your PC
# The same name is used for the ports the KDC and Kafka publish, so the Solace broker can
# reach them without being attached to any compose network.
HOST_ALIAS=host.docker.internal

# ---- Ports the KDC and Kafka publish on your PC (reachable as HOST_ALIAS:<port>) ----
# Change KDC_HOST_PORT if 88 is taken on your machine (then also KDC_ADDRESS_FOR_SOLACE below).
KDC_HOST_PORT=88
KAFKA_HOST_PORT=9093

# ---- Your EXISTING Solace PubSub+ container (not managed by this compose file) ----
# Name (or ID) of the running Solace container - only needed for the CLI helper scripts
# (show commands, scaling). Leave empty to auto-detect a single solace/solace-pubsub-* container.
SOLACE_CONTAINER=solace-ent-10-26
# Where the toolboxes reach the broker: https://localhost:1943 on your PC
# = https://host.docker.internal:1943 from inside a container.
SOLACE_HOST=host.docker.internal
SOLACE_SEMP_SCHEME=https
SOLACE_SEMP_PORT=1943
# the broker's default server certificate is self-signed -> accept it
SOLACE_SEMP_INSECURE=true
# REST messaging and MQTT host ports of your broker (9000 plain / 9443 TLS, 1883 plain / 8883 TLS)
SOLACE_REST_SCHEME=http
SOLACE_REST_PORT=9000
SOLACE_MQTT_PORT=1883
# SEMP credentials
SOLACE_ADMIN_USER=admin
SOLACE_ADMIN_PASSWORD=admin
SOLACE_VPN=default

# What the Solace broker itself uses to reach the KDC and Kafka (= your PC's published ports).
# Must agree with HOST_ALIAS / KDC_HOST_PORT / KAFKA_HOST_PORT above. The Kafka SPN is
# <KAFKA_SERVICE_NAME>/<host part of KAFKA_BOOTSTRAP_FOR_SOLACE>@REALM.
KDC_ADDRESS_FOR_SOLACE=host.docker.internal:88
KAFKA_BOOTSTRAP_FOR_SOLACE=host.docker.internal:9093

# Optional alternative ("network mode"): attach the Solace container to this compose network with
# scripts/attach-solace.sh and use SOLACE_HOST=solace, KDC_ADDRESS_FOR_SOLACE=kdc:88,
# KAFKA_BOOTSTRAP_FOR_SOLACE=kafka:9093, HOST_ALIAS=kafka. See README section 7.
COMPOSE_NETWORK=kafka-kerberos-net

# Scaling parameters the broker needs for Kafka bridging (default on a fresh broker is 0!)
SOLACE_MAX_KAFKA_BRIDGES=10
SOLACE_MAX_KAFKA_BROKER_CONNECTIONS=300

# ---- Bridge object names on the Solace VPN ----
KAFKA_RECEIVER_NAME=kr-kafka-kerberos
KAFKA_SENDER_NAME=ks-kafka-kerberos
KAFKA_CONSUMER_GROUP=solace-bridge

# ---- Data flow ----
# Kafka -> Solace : Kafka topic KAFKA_TOPIC_IN  ->  Solace topic kafka/<kafka-topic>  -> queue SOLACE_QUEUE_FROM_KAFKA
KAFKA_TOPIC_IN=orders-in
SOLACE_QUEUE_FROM_KAFKA=q.from-kafka
# Solace -> Kafka : Solace topic SOLACE_TOPIC_TO_KAFKA -> queue SOLACE_QUEUE_TO_KAFKA -> Kafka topic KAFKA_TOPIC_OUT
SOLACE_TOPIC_TO_KAFKA="solace/orders/>"
SOLACE_QUEUE_TO_KAFKA=q.to-kafka
KAFKA_TOPIC_OUT=orders-out
